Output examples/demo/out/choose.gif

Set Shell bash
Set Width 1200
Set Height 460
Set FontSize 22
Set Padding 20
Set TypingSpeed 40ms

Hide
Type "PS1='$ '"
Enter
Type "clear"
Enter
Show

Type "cat examples/inputs/kaguya.txt | ./xylitol.sh choose --page-size=6"
Enter
Sleep 1.2s
Down
Sleep 500ms
Down
Sleep 600ms
Right
Sleep 1s
Left
Sleep 800ms
Enter
Sleep 1.5s

Type "cat examples/inputs/kaguya.txt | ./xylitol.sh choose --no-limit --page-size=6"
Enter
Sleep 1.2s
Tab
Sleep 600ms
Down
Sleep 350ms
Down
Sleep 350ms
Tab
Sleep 600ms
Down
Sleep 350ms
Tab
Sleep 900ms
Enter
Sleep 2s
