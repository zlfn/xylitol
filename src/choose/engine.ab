import * from "std/env"
import * from "std/math"
import * from "../utils.ab"

/// A chooser driven by its caller.
///
/// Amber has no callbacks, so the engine cannot ask for an item's text on its
/// own. The caller runs the loop instead and hands over one page of labels at
/// a time, which is what lets it build them lazily. `xyl_choose` and
/// `xyl_file` show the shape of that loop.
///
/// Only the engine writes to the terminal; callers just produce text.

/// `chooser_step` handled the key and redrew whatever changed.
pub const CHOOSER_CONTINUE = 0
/// The page changed and the engine needs its labels before it can draw.
pub const CHOOSER_NEED_PAGE = 1
/// The user confirmed the selection.
pub const CHOOSER_DONE = 2

let _total = 0
let _page_size = 10
let _display_count = 0
let _total_pages = 1
let _current_page = 0
let _selected = 0
let _cursor = "> "
let _multi = false
let _limit = -1
let _term_width = 80
let _has_header = false
let _page = [Text]
let _page_count = 0
let _checked = [Bool]
/// Tracked alongside `_checked` because counting it on every keypress would
/// walk the whole list, and `or` evaluates both of its operands.
let _checked_count = 0
let _first_render = true
/// Set when moving up off the top of a page. The cursor belongs on the last
/// item of the previous page, but its length is only known once the caller
/// has handed over that page, so `chooser_set_page` finishes the move.
let _up_paged = false

fun render_single_page(): Null {
    const cursor_len = len(_cursor)
    const max_option_width = _term_width - cursor_len - 1
    for i in 0.._page_count {
        const truncated = cutoff_text(_page[i], max_option_width)
        if i == _selected {
            eprintf(colored_secondary(_cursor + truncated + "\n"))
        } else {
            print_blank(cursor_len)
            eprintf(truncated + "\n")
        }
    }
    const remaining_slots = _display_count - _page_count
    if remaining_slots > 0 {
        for _ in 0..remaining_slots {
            eprintf("\x1b[K\n")
        }
    }
}

fun render_multi_page(): Null {
    const cursor_len = len(_cursor)
    const max_option_width = _term_width - cursor_len - 3 // 2 for check mark
    const page_start = chooser_page_start()
    for i in 0.._page_count {
        const global_idx = page_start + i
        const check_mark = _checked[global_idx] then "✓ " else "• "
        const truncated = cutoff_text(_page[i], max_option_width)
        if {
            i == _selected: eprintf(colored_secondary(_cursor + check_mark + truncated + "\n"))
            _checked[global_idx]: {
                print_blank(cursor_len)
                eprintf(colored_secondary(check_mark + truncated + "\n"))
            }
            else: {
                print_blank(cursor_len)
                eprintf(check_mark + truncated + "\n")
            }
        }
    }
    const remaining_slots = _display_count - _page_count
    if remaining_slots > 0 {
        for _ in 0..remaining_slots {
            eprintf("\x1b[K\n")
        }
    }
}

fun render_page(): Null {
    if _multi {
        render_multi_page()
    } else {
        render_single_page()
    }
}

fun render_page_indicator(): Null {
    if _total_pages > 1 {
        eprintf("\x1b[G\x1b[K")
        eprintf_colored("Page {_current_page + 1}/{_total_pages}", 90)
        eprintf("\x1b[G")
    }
}

fun render_tooltip_line(): Null {
    if not _multi {
        // "↑↓ select • enter confirm" = 9 + 3 + 13 = 25
        // "↑↓ select • ←→ page • enter confirm" = 9 + 3 + 8 + 3 + 13 = 36
        if _total_pages > 1 {
            render_tooltip(["↑↓", "select", "←→", "page", "enter", "confirm"], 36, _term_width)
        } else {
            render_tooltip(["↑↓", "select", "enter", "confirm"], 25, _term_width)
        }
    } else {
        // "↑↓ select • x toggle • enter confirm" = 9 + 3 + 8 + 3 + 13 = 36
        // "↑↓ select • x toggle • a all • enter confirm" = 36 + 5 + 3 = 44
        // "↑↓ select • x toggle • ←→ page • enter confirm" = 36 + 8 + 3 = 47
        // "↑↓ select • x toggle • a all • ←→ page • enter confirm" = 36 + 5 + 3 + 8 + 3 = 55
        if {
            _total_pages > 1 and _limit < 0: render_tooltip(["↑↓", "select", "x", "toggle", "a", "all", "←→", "page", "enter", "confirm"], 55, _term_width)
            _total_pages > 1: render_tooltip(["↑↓", "select", "x", "toggle", "←→", "page", "enter", "confirm"], 47, _term_width)
            _limit < 0: render_tooltip(["↑↓", "select", "x", "toggle", "a", "all", "enter", "confirm"], 44, _term_width)
            else: render_tooltip(["↑↓", "select", "x", "toggle", "enter", "confirm"], 36, _term_width)
        }
    }
}

/// Start a chooser over `total` items. Locks the terminal and reserves the
/// lines the widget draws on, which `chooser_end` releases.
pub fun chooser_begin(total: Int, page_size: Int, header: Text, cursor: Text, multi: Bool, limit: Int): Null {
    _total = total
    _cursor = cursor
    _multi = multi
    _limit = limit
    _current_page = 0
    _selected = 0
    _first_render = true
    _up_paged = false
    _checked_count = 0
    _has_header = header != ""

    stty_lock()
    hide_cursor()

    _term_width = term_width()
    const term_height = term_height()
    const max_page_size = term_height - (_has_header then 3 else 2)
    _page_size = page_size
    if _page_size > max_page_size {
        _page_size = max_page_size
    }

    if _has_header {
        eprintf(cutoff_text(header, _term_width) + "\n")
    }

    _total_pages = math_floor((total + _page_size - 1) / _page_size)
    _display_count = _page_size
    if total < _page_size {
        _display_count = total
    }

    if multi {
        _checked = [Bool]
        for _ in 0..total {
            _checked += [false]
        }
    }

    new_line(_display_count)
    eprintf("\x1b[G")
    if _total_pages > 1 {
        eprintf_colored("Page {_current_page + 1}/{_total_pages}", 90)
    }
    new_line(1)
    render_tooltip_line()
    go_up(_display_count + 1)
    eprintf("\x1b[G")
}

pub fun chooser_page_start(): Int {
    return _current_page * _page_size
}

pub fun chooser_page_count(): Int {
    const start = chooser_page_start()
    let end = start + _page_size
    if end > _total {
        end = _total
    }
    return end - start
}

/// Hand the engine the labels of the current page and draw them.
/// `page` must hold exactly `chooser_page_count()` labels, for the items
/// starting at `chooser_page_start()`.
pub fun chooser_set_page(ref page: [Text]): Null {
    _page = page
    _page_count = len(page)
    if _first_render {
        _first_render = false
        render_page()
    } else {
        if _up_paged {
            _selected = _page_count - 1
            _up_paged = false
        }
        go_up(1)
        remove_line(_display_count - 1)
        remove_current_line()
        eprintf("\x1b[G")
        render_page()
        render_page_indicator()
    }
}

/// Move the highlight from `prev_selected` to `_selected`, redrawing only
/// those two lines.
fun redraw_selection(prev_selected: Int): Null {
    const page_start = chooser_page_start()
    const check_width = _multi then 3 else 1
    const max_option_width = _term_width - len(_cursor) - check_width

    go_up(_display_count - prev_selected)
    eprintf("\x1b[K")
    print_blank(len(_cursor))
    if _multi {
        const was_checked = _checked[page_start + prev_selected]
        const prev_line = (was_checked then "✓ " else "• ") + cutoff_text(_page[prev_selected], max_option_width)
        if was_checked {
            eprintf(colored_secondary(prev_line))
        } else {
            eprintf(prev_line)
        }
    } else {
        eprintf(cutoff_text(_page[prev_selected], max_option_width))
    }

    go_up_or_down(_selected - prev_selected)
    eprintf("\x1b[G")
    eprintf("\x1b[K")
    const mark = _multi then (_checked[page_start + _selected] then "✓ " else "• ") else ""
    eprintf(colored_secondary(_cursor + mark + cutoff_text(_page[_selected], max_option_width)))

    go_down(_display_count - _selected)
    eprintf("\x1b[G")
}

/// Redraw the highlighted line after its check mark changed. Multi mode only.
fun redraw_current_line(): Null {
    const page_start = chooser_page_start()
    const max_option_width = _term_width - len(_cursor) - 3
    go_up(_display_count - _selected)
    eprintf("\x1b[G")
    eprintf("\x1b[K")
    const check_mark = _checked[page_start + _selected] then "✓ " else "• "
    eprintf(colored_secondary(_cursor + check_mark + cutoff_text(_page[_selected], max_option_width)))
    go_down(_display_count - _selected)
    eprintf("\x1b[G")
}

/// Read one key and update the selection.
pub fun chooser_step(): Int {
    const key = get_key()
    const prev_selected = _selected
    const prev_page = _current_page
    const page_start = chooser_page_start()
    _up_paged = false

    if {
        key == "UP" or key == "k" {
            if {
                _selected == 0 and _total_pages > 1 {
                    if _current_page > 0 {
                        _current_page -= 1
                    } else {
                        _current_page = _total_pages - 1
                    }
                    _up_paged = true
                }
                _selected == 0 {
                    _selected = _page_count - 1
                }
                else {
                    _selected = _selected - 1
                }
            }
        }
        key == "DOWN" or key == "j" {
            if _selected == _page_count - 1 {
                if _current_page < _total_pages - 1 {
                    _current_page += 1
                } else {
                    _current_page = 0
                }
                _selected = 0
            } else {
                _selected = _selected + 1
            }
        }
        key == "LEFT" or key == "h" {
            if _current_page > 0 {
                _current_page -= 1
            }
            _selected = 0
        }
        key == "RIGHT" or key == "l" {
            if _current_page < _total_pages - 1 {
                _current_page += 1
                _selected = 0
            } else {
                _selected = _page_count - 1
            }
        }
        _multi and (key == "x" or key == "X") {
            const global_selected = page_start + _selected
            if {
                _checked[global_selected] {
                    _checked[global_selected] = false
                    _checked_count -= 1
                }
                _limit < 0 or _checked_count < _limit {
                    _checked[global_selected] = true
                    _checked_count += 1
                }
                else: return CHOOSER_CONTINUE
            }
            redraw_current_line()
            return CHOOSER_CONTINUE
        }
        _multi and (key == "a" or key == "A") and _limit < 0 {
            const all_checked = _checked_count == _total
            for i in 0.._total {
                _checked[i] = not all_checked
            }
            _checked_count = all_checked then 0 else _total
            go_up(_display_count)
            eprintf("\x1b[G")
            render_page()
            return CHOOSER_CONTINUE
        }
        key == "INPUT" {
            return CHOOSER_DONE
        }
        else: return CHOOSER_CONTINUE
    }

    if prev_page != _current_page {
        return CHOOSER_NEED_PAGE
    }
    if prev_selected != _selected {
        redraw_selection(prev_selected)
    }
    return CHOOSER_CONTINUE
}

/// Index of the highlighted item within the whole list.
pub fun chooser_selected(): Int {
    return chooser_page_start() + _selected
}

/// Whether item `index` is checked. Only meaningful in multi mode.
pub fun chooser_is_checked(index: Int): Bool {
    return _checked[index]
}

/// Erase the widget and unlock the terminal.
pub fun chooser_end(): Null {
    let total_lines = _display_count + 2
    if _has_header {
        total_lines += 1
    }
    go_down(1)
    remove_line(total_lines - 1)
    remove_current_line()
    stty_unlock()
    show_cursor()
}
