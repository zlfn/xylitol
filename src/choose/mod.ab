import * from "std/env"
import * from "../utils.ab"
import * from "./engine.ab"

/// Prompts the user to choose a single option from a list.
///
/// ### Parameters
/// - `options`: The list of options to choose from.
/// - `cursor`: The cursor text to indicate the selected option.
/// - `header`: An optional header message to display above the options. (ANSI supported)
/// - `page_size`: The number of options to display per page.
pub fun xyl_choose(
    ref options: [Text],
    cursor: Text = "> ",
    header: Text = "\x1b[1mChoose:\x1b[0m",
    page_size: Int = 10,
): Text {
    // `len` copies the whole array, so the count is taken once and reused.
    const total = len(options)
    if total == 0 {
        eprintf_colored("ERROR: No options provided.\n", 31)
        exit(1)
    }

    chooser_begin(total, page_size, header, cursor, false, -1)
    let need_page = true
    loop {
        if need_page {
            let page = [Text]
            const start = chooser_page_start()
            const count = chooser_page_count()
            for i in start..start + count {
                page += [options[i]]
            }
            chooser_set_page(page)
        }
        const step = chooser_step()
        if step == CHOOSER_DONE {
            break
        }
        need_page = step == CHOOSER_NEED_PAGE
    }

    const selected = chooser_selected()
    chooser_end()
    return options[selected]
}

/// Prompts the user to choose multiple options from a list.
///
/// ### Parameters
/// - `options`: The list of options to choose from.
/// - `cursor`: The cursor text to indicate the selected option.
/// - `header`: An optional header message to display above the options. (ANSI supported)
/// - `limit`: The maximum number of options the user can select. Use -1 for no limit.
/// - `page_size`: The number of options to display per page.
pub fun xyl_multi_choose(
    ref options: [Text],
    cursor: Text = "> ",
    header: Text = "Choose:",
    limit: Int = -1,
    page_size: Int = 10,
): [Text] {
    const total = len(options)
    if total == 0 {
        eprintf_colored("ERROR: No options provided.\n", 31)
        return [Text]
    }

    chooser_begin(total, page_size, header, cursor, true, limit)
    let need_page = true
    loop {
        if need_page {
            let page = [Text]
            const start = chooser_page_start()
            const count = chooser_page_count()
            for i in start..start + count {
                page += [options[i]]
            }
            chooser_set_page(page)
        }
        const step = chooser_step()
        if step == CHOOSER_DONE {
            break
        }
        need_page = step == CHOOSER_NEED_PAGE
    }

    chooser_end()

    let result = [Text]
    for i in 0..total {
        if chooser_is_checked(i) {
            result += [options[i]]
        }
    }
    return result
}
