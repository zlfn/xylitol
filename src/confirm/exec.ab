import * from "std/text"
import * from "std/env"

import * from "./mod.ab"
import * from "./help.ab"
import * from "../utils.ab"

pub fun execute_confirm(parameters: [Text]): Text {
    let header = "\x1b[1m" + colored_primary("Are you sure?")
    let default_yes = true

    for param in parameters {
        if {
            param == "-h" or param == "--help" {
                print_confirm_help()
                exit(0)
            }
            starts_with(param, "--header=") {
                header = slice(param, len("--header="))
            }
            starts_with(param, "--default=") {
                const value = slice(param, len("--default="))
                if {
                    value == "yes" or value == "y": default_yes = true
                    value == "no" or value == "n": default_yes = false
                    else: {
                        eprintf_colored("ERROR: Invalid default value: " + value + ". Use 'yes' or 'no'.\n", 31)
                        exit(1)
                    }
                }
            }
        }
    }

    const display_header = header == "" or has_ansi_escape(header) then escape_ansi(header) else "\\x1b[1m" + colored_primary(header)
    const result = xyl_confirm(display_header, default_yes)
    return result then "yes" else "no"
}
