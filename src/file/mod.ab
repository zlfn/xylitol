import * from "std/env"
import * from "std/text"
import * from "../utils.ab"
import * from "../choose/engine.ab"

/// Format a single entry for display
/// Directories are colored with accent color and have trailing /
fun format_entry_display(name: Text, file_type: Text, target: Text): Text {
    if file_type == "d" {
        return name + colored_primary("/")
    }
    if file_type == "l" {
        return name + colored_accent(" > ") + colored_primary(target)
    }
    return name
}

/// File browser that lets user navigate and select a file.
///
/// ### Parameters
/// - `start_path`: Starting directory path (default: current directory).
/// - `cursor`: The cursor text to indicate the selected option.
/// - `show_hidden`: Whether to show hidden files (starting with .).
/// - `page_size`: The number of entries to display per page.
pub fun xyl_file(
    start_path: Text = "",
    cursor: Text = "> ",
    show_hidden: Bool = false,
    page_size: Int = 10,
): Text {
    stty_lock()

    // Initialize current path
    let current_path = start_path
    if current_path == "" {
        current_path = get_cwd()
    }
    current_path = normalize_path(current_path)

    loop {
        eprintf(colored_primary("Loading files..."))

        // Get directory entries
        let listed_names = [Text]
        let listed_types = [Text]
        let listed_targets = [Text]
        get_directory_entries(current_path, listed_names, listed_types, listed_targets)

        // No display text is built here. The loop below formats one page at a
        // time, so a directory with thousands of entries only formats the
        // handful that are on screen.
        let names = [Text]
        let types = [Text]
        let targets = [Text]

        // Add parent directory entry (..)
        if current_path != "/" {
            names += [".."]
            types += ["d"]
            targets += [""]
        }

        for i in 0..len(listed_names) {
            const name = listed_names[i]
            // Skip hidden files if not showing them
            if not show_hidden and starts_with(name, ".") {
                continue
            }
            names += [name]
            types += [listed_types[i]]
            targets += [listed_targets[i]]
        }

        const total = len(names)
        if total == 0 {
            eprintf_colored("ERROR: Directory is empty or inaccessible.\n", 31)
            stty_unlock()
            return ""
        }

        const header = colored_primary(current_path)
        remove_current_line()

        chooser_begin(total, page_size, header, cursor, false, -1)
        let need_page = true
        loop {
            if need_page {
                let page = [Text]
                const start = chooser_page_start()
                const count = chooser_page_count()
                for i in start..start + count {
                    page += [format_entry_display(names[i], types[i], targets[i])]
                }
                chooser_set_page(page)
            }
            const step = chooser_step()
            if step == CHOOSER_DONE {
                break
            }
            need_page = step == CHOOSER_NEED_PAGE
        }
        const selected_idx = chooser_selected()
        chooser_end()

        const name = names[selected_idx]
        const file_type = types[selected_idx]

        if {
            name == ".." {
                current_path = get_parent_dir(current_path)
            }
            file_type == "d" {
                current_path = path_join(current_path, name)
                current_path = normalize_path(current_path)
            }
            file_type == "l" {
                // Resolve symlink target path
                const target = targets[selected_idx]
                let target_path = target
                if not starts_with(target, "/") {
                    target_path = path_join(current_path, target)
                }
                // Follow symlink if it points to a directory, otherwise return path
                if dir_exists(target_path) {
                    current_path = target_path
                    current_path = normalize_path(current_path)
                } else {
                    stty_unlock()
                    return path_join(current_path, name)
                }
            }
            else: {
                stty_unlock()
                return path_join(current_path, name)
            }
        }
    }

    stty_unlock()
    return ""
}
