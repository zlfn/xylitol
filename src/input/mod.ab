import * from "std/env"
import * from "../utils.ab"

/// Prompts the user single-line input with a placeholder.
///
/// ### Parameters
/// - `prompt`: The prompt message to display to the user.
/// - `placeholder`: The placeholder text to show in the input field. Shown
///   only on Bash 4.0 and later, which can put the keypress that dismisses it
///   back into the line being edited.
/// - `header`: An optional header message to display above the prompt. (ANSI supported)
/// - `password`: A boolean indicating whether the input should be masked.
pub fun xyl_input(
    prompt: Text,
    placeholder: Text,
    header: Text = "",
    password: Bool = false,
): Text {
    stty_lock()

    const term_width = term_width()

    if header != "" {
        eprintf(cutoff_text(header, term_width) + "\n")
    }

    new_line(2)
    // "enter submit" = 12
    render_tooltip(["enter", "submit"], 12, term_width)
    go_up(2)
    eprintf("\x1b[G")

    // Showing the placeholder means swallowing the first keypress to know when
    // to erase it, and only `read -i` can hand that character back. Shells
    // without it skip the placeholder rather than lose what was typed.
    const can_preset = trust $ [ "\$\{EXEC_SHELL_VERSION[0]}" -ge 4 ] && echo 1 || echo 0 $

    let char = ""
    eprintf(prompt)
    if can_preset == "1" {
        eprintf_colored(placeholder, 90)
        char = get_char()
        remove(len(placeholder) + 1)
    }
    remove(len(prompt))

    let text = ""
    if not password {
        stty_unlock()
        text = trust $ if [ "\$\{EXEC_SHELL_VERSION[0]}" -ge 4 ]; then read -e -i "{char}" -p "{prompt}" text < /dev/tty; else read -e -p "{prompt}" text < /dev/tty; fi; printf "%s" "\$text" $
        stty_lock()
    } else {
        text = trust $ if [ "\$\{EXEC_SHELL_VERSION[0]}" -ge 4 ]; then read -es -i "{char}" -p "{prompt}" text < /dev/tty; else read -es -p "{prompt}" text < /dev/tty; fi; printf "%s" "\$text" $
    }

    // Calculate how many lines the input takes up (prompt + text may wrap)
    const input_display_len = get_visible_len(prompt + text)
    let input_lines = (input_display_len + term_width - 1) / term_width
    if input_lines < 1 {
        input_lines = 1
    }

    if input_lines < 3 {
        go_down(2 - input_lines)
        remove_line(2)
        remove_current_line()
    }
    if input_lines >= 3 {
        remove_line(input_lines)
    }
    if header != "" {
        remove_line(1)
        remove_current_line()
    }

    stty_unlock()
    return text
}
