#!/usr/bin/env amber
import * from "./utils.ab"
import { printf } from "std/env"
import { print_help } from "./help.ab"
import { execute_input } from "./input/exec.ab"
import { execute_choose } from "./choose/exec.ab"
import { execute_filter } from "./filter/exec.ab"
import { execute_confirm } from "./confirm/exec.ab"
import { execute_file } from "./file/exec.ab"

const VERSION = "0.1.0"
const AMBER_VERSION = "0.6.0-alpha"

fun trap_cleanup(): Null {
    trust $ trap 'printf "\x1b[?25h\x1b[0m" >&2; 
            stty echo icanon 2>/dev/null < /dev/tty' EXIT $
}

main(args) {
    trap_cleanup()

    // `args[1]` must not be read before the length is checked,
    // because `or` evaluates both of its operands.
    if len(args) < 2 {
        print_help()
        exit(0)
    }

    const command = args[1]

    if {
        command == "help" or command == "--help" or command == "-h": {
            print_help()
        }
        command == "input": {
            echo(execute_input(args))
        }
        command == "choose": {
            echo(execute_choose(args))
        }
        command == "filter": {
            echo(execute_filter(args))
        }
        command == "confirm": {
            const result = execute_confirm(args)
            if {
                result == "yes": exit(0)
                else: exit(1)
            }
        }
        command == "file": {
            echo(execute_file(args))
        }
        command == "version" or command == "--version" or command == "-v": {
            printf(colored_primary("xylitol.sh"))
            printf(" version: ")
            printf(colored_accent(VERSION))
            echo("")
            printf_colored("written in Amber: ", 90)
            printf_colored("  " + AMBER_VERSION, 90)
        }
        else: {
            print_help()
            printf_colored("ERROR: Unknown command '" + command + "'", 91)
        }
    }
}
