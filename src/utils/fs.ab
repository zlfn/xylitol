import { split, starts_with, char_at, slice } from "std/text"
pub import { dir_exists } from "std/fs"

/// Read the entries of `path` into three parallel arrays.
/// `types` holds the first character of the long listing, so "d" for a
/// directory and "l" for a symbolic link. `targets` holds the destination
/// of a symbolic link and is empty for every other kind of entry.
///
/// `names` comes from the `ls` builtin, which sorts under `LC_ALL=C`.
/// The long listings below must use the same collation, otherwise the
/// three arrays fall out of alignment for non-ASCII file names.
pub fun get_directory_entries(path: Text, ref names: [Text], ref types: [Text], ref targets: [Text]): Null {
    names += trust ls(path, true, false)
    const types_output = trust $ LC_ALL=C ls -lA "{path}" 2>/dev/null | tail -n +2 | sed 's/^\(.\).*/\1/' $
    // The blanking expression runs first, otherwise it would also match the
    // already rewritten target of a symbolic link. Every line is then given a
    // leading ":" because `split` treats newlines as whitespace and would
    // collapse the empty lines that non-link entries produce.
    const targets_output = trust $ LC_ALL=C ls -lA "{path}" 2>/dev/null | tail -n +2 | sed -e '/^l/!s/.*//' -e '/^l/s/.* -> //' -e 's/^/:/' $
    types += split(types_output, "\n")
    for marked in split(targets_output, "\n") {
        targets += [slice(marked, 1)]
    }
}

/// Get current working directory
pub fun get_cwd(): Text {
    return trust $ pwd $
}

/// Normalize a path (resolve .. and .)
pub fun normalize_path(path: Text): Text {
    const normalized = trust $ cd "{path}" 2>/dev/null && pwd $
    if normalized == "" {
        return path
    }
    return normalized
}

/// Join two path components
pub fun path_join(base: Text, child: Text): Text {
    if base == "/" {
        return "/" + child
    }
    return base + "/" + child
}

/// Get parent directory
pub fun get_parent_dir(path: Text): Text {
    const parent = trust $ dirname "{path}" $
    return parent
}
