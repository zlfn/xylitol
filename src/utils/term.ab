import { split, parse_int, match_regex } from "std/text"

/// global variables to store terminal size
/// (prevent multiple queries in one session)
let _got_term_size = false
let _term_size = [80, 24]

/// stty lock/unlock using environment variable for cross-module state
trust $ export XYLITOL_RUNTIME_STTY_COUNT=0 $

/// Lock the terminal (disable echo). Uses reference counting via environment variable.
pub fun stty_lock(): Null {
    let count = trust $ echo "\$\{XYLITOL_RUNTIME_STTY_COUNT:-0}" $
    let count_num = parse_int(count) failed { 0 }
    if count_num == 0 {
        trust $ stty -echo < /dev/tty $
    }
    count_num += 1
    trust $ export XYLITOL_RUNTIME_STTY_COUNT={count_num} $
}

/// Unlock the terminal (enable echo). Uses reference counting via environment variable.
pub fun stty_unlock(): Null {
    let count = trust $ echo "\$\{XYLITOL_RUNTIME_STTY_COUNT:-0}" $
    let count_num = parse_int(count) failed { 0 }
    if count_num > 0 {
        count_num -= 1
        trust $ export XYLITOL_RUNTIME_STTY_COUNT={count_num} $
        if count_num == 0 {
            trust $ stty echo < /dev/tty $
        }
    }
}

/// Parse a size component, returning 0 when the text is not a number.
fun parse_size(text: Text): Int {
    // `match_regex` uses BRE by default, where `+` is a literal character
    if not match_regex(text, "^[0-9][0-9]*$") {
        return 0
    }
    return trust parse_int(text)
}

/// Ask the terminal for its size with the xterm `\x1b[18t` extension.
/// Response format: `\x1b[8;rows;colst`.
/// The read times out, so terminals without the extension do not block execution.
fun query_term_size(): Bool {
    let result = trust $ printf '\x1b[18t' > /dev/tty; IFS=';' read -t 0.5 -rsd t _ignore height width < /dev/tty 2>/dev/null; echo "\$height; \$width" $
    let parts = split(result, ";")
    if len(parts) != 2 {
        return false
    }
    let rows = parse_size(parts[0])
    let cols = parse_size(parts[1])
    if rows <= 0 or cols <= 0 {
        return false
    }
    _term_size = [cols, rows]
    return true
}

/// Read the terminal size from the tty itself.
/// Used when the terminal does not support the `\x1b[18t` extension.
fun stty_term_size(): Bool {
    let result = trust $ stty size < /dev/tty 2>/dev/null $
    let parts = split(result, " ")
    if len(parts) != 2 {
        return false
    }
    let rows = parse_size(parts[0])
    let cols = parse_size(parts[1])
    if rows <= 0 or cols <= 0 {
        return false
    }
    _term_size = [cols, rows]
    return true
}

/// Get the terminal size (columns, rows).
/// Keeps the default size when it cannot be detected by any means.
fun get_term_size(): Null {
    let detected = query_term_size()
    if not detected {
        detected = stty_term_size()
    }
    _got_term_size = true
}

pub fun term_size(): [Int] {
    if not _got_term_size {
        get_term_size()
    }
    return _term_size
}

/// Get the terminal width (columns).
pub fun term_width(): Int {
    if not _got_term_size {
        get_term_size()
    }
    return _term_size[0]
}

/// Get the terminal height (rows).
pub fun term_height(): Int {
    if not _got_term_size {
        get_term_size()
    }
    return _term_size[1]
}
